# Skopiuj do .env (cp .env.example .env) i ustaw własne hasła.
# Plik .env nie trafia do repozytorium.

# Aplikacja (Nginx)
APP_PORT=8080

# PostgreSQL
POSTGRES_DB=wdpai
POSTGRES_USER=wdpai
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5433

# Mailpit (panel WWW)
MAILPIT_PORT=8025

# pgAdmin (login do panelu WWW)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me
PGADMIN_PORT=5050
PGADMIN_CONTAINER_NAME=pg-admin

# Ollama (API modeli językowych)
OLLAMA_PORT=11434
